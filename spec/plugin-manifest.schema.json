{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KevinChu1110/tshu-lai/spec/plugin-manifest.schema.json",
  "title": "Tshù-lāi Plugin Manifest",
  "type": "object",
  "required": ["name", "version", "kind", "server"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "kind": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["knowledge", "trigger", "tool", "voice", "vision", "camera"] }
    },
    "languages": { "type": "array", "items": { "type": "string" } },
    "server": {
      "type": "object",
      "description": "MCP server 啟動方式（stdio）或 URL（streamable http）",
      "oneOf": [
        {
          "required": ["command"],
          "properties": {
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        { "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } }
      ]
    },
    "provides": {
      "type": "object",
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event"],
            "properties": {
              "event": { "type": "string", "description": "如 tv.program_started、door.opened" },
              "description": { "type": "string" }
            }
          }
        },
        "tools": { "type": "array", "items": { "type": "string" }, "description": "MCP tool 名稱" },
        "topics": { "type": "array", "items": { "type": "string" }, "description": "這個 plugin 能供給的話題" },
        "voice": {
          "type": "object",
          "properties": { "stt": { "type": "boolean" }, "tts": { "type": "boolean" }, "translate": { "type": "boolean" } }
        },
        "vision": {
          "type": "object",
          "properties": { "lipsync": { "type": "boolean" }, "idle_video": { "type": "boolean" } }
        },
        "camera": {
          "type": "object",
          "properties": { "matting": { "type": "boolean" }, "insert_person": { "type": "boolean" } }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "enum": ["network", "memory.read", "memory.write", "media.read", "location"] },
      "description": "plugin 需要什麼。預設什麼都沒有。"
    }
  }
}
